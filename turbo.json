{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "FRONTEND_URL",
        "AUTH_SERVICE_PORT",
        "API_PORT",
        "KAFKA_BROKERS",
        "KAFKA_CLIENT_ID",
        "KAFKA_SSL",
        "KAFKA_SASL_USERNAME",
        "KAFKA_SASL_PASSWORD"
      ]
    }
  }
}
