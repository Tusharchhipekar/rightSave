
FROM oven/bun:1-alpine AS migrator
WORKDIR /app

RUN echo '{"name":"migrator","private":true}' > package.json \
    && bun add prisma@7.10.0

COPY packages/db-prisma/prisma ./prisma
COPY packages/db-prisma/prisma7.config.ts ./

CMD ["bunx", "prisma", "migrate", "deploy", "--config", "prisma7.config.ts"]