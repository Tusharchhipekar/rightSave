FROM oven/bun:1-slim AS base

FROM base AS pruner
WORKDIR /app
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun add -g turbo
COPY . .
RUN turbo prune frontend --docker

# Builder is alpine (same libc as the runner) so native deps like sharp
# resolve to the musl binaries that actually run in the final image.
# NEXT_PUBLIC_* values are inlined at build time, so they are build args.
FROM oven/bun:1-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_AUTH_API_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DEMO_EMAIL
ARG NEXT_PUBLIC_DEMO_PASSWORD
ENV NEXT_PUBLIC_AUTH_API_URL=$NEXT_PUBLIC_AUTH_API_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_DEMO_EMAIL=$NEXT_PUBLIC_DEMO_EMAIL \
    NEXT_PUBLIC_DEMO_PASSWORD=$NEXT_PUBLIC_DEMO_PASSWORD \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=pruner /app/out/json/ .
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN --mount=type=cache,target=/app/apps/frontend/.next/cache \
    bun run --cwd apps/frontend build

# Standalone output: server.js plus only the traced node_modules. With
# outputFileTracingRoot at the repo root, the app lives at apps/frontend/.
FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S -g 1001 frontend \
    && adduser -S -u 1001 -G frontend frontend

COPY --from=builder --chown=frontend:frontend /app/apps/frontend/.next/standalone ./
COPY --from=builder --chown=frontend:frontend /app/apps/frontend/.next/static ./apps/frontend/.next/static
COPY --from=builder --chown=frontend:frontend /app/apps/frontend/public ./apps/frontend/public

USER frontend
EXPOSE 3000
CMD ["node", "apps/frontend/server.js"]